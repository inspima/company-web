Options -MultiViews
RewriteEngine On

# Allow requests to real files and directories (assets, dist, etc.)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Pass through admin and API PHP files
RewriteCond %{REQUEST_URI} ^/admin [OR]
RewriteCond %{REQUEST_URI} ^/api\.php [OR]
RewriteCond %{REQUEST_URI} ^/sitemap
RewriteRule ^ - [L]

# Serve PHP entry point — handles dynamic SEO meta injection
RewriteRule ^ /index.php [L]
